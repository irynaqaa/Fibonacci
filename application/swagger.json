{
  "swagger": "2.0",
  "info": {
    "description": "API documentation for Pet API",
    "version": "1.0.0",
    "title": "Pet API"
  },
  "host": "localhost:3000",
  "basePath": "/v1",
  "schemes": ["http"],
  "paths": {
    "/pets": {
      "get": {
        "summary": "List all pets",
        "description": "Retrieves a paginated list of pets.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Number of pets to return",
            "required": false,
            "type": "integer"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of pets to skip before starting to collect the result set",
            "required": false,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of pets",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Pet"
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      },
      "post": {
        "summary": "Create a pet",
        "description": "Creates a new pet with the provided JSON data.",
        "parameters": [{
          "name": "pet",
          "in": "body",
          "description": "Pet object that needs to be added",
          "required": true,
          "schema": {
            "$ref": "#/definitions/Pet"
          }
        }],
        "responses": {
          "201": {
            "description": "Pet created"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "summary": "Find pet by ID",
        "description": "Returns a single pet",
        "parameters": [{
          "name": "petId",
          "in": "path",
          "required": true,
          "type": "integer",
          "description": "ID of pet to return"
        }],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "$ref": "#/definitions/Pet"
            }
          },
          "400": {
            "description": "Invalid ID supplied"
          },
          "404": {
            "description": "Pet not found"
          }
        }
      }
    }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    }
  }
}